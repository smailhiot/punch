<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/w_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HORS SERVICE"
        android:textColor="#66706B"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_client"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Punch"
        android:textColor="#1B1F1D"
        android:textSize="19sp"
        android:textStyle="bold" />

    <Chronometer
        android:id="@+id/w_chrono"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#1B1F1D"
        android:textSize="26sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/w_sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text=""
        android:textColor="#66706B"
        android:textSize="13sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/w_button"
            android:layout_width="116dp"
            android:layout_height="116dp"
            android:layout_gravity="center"
            android:background="@drawable/w_btn_in"
            android:gravity="center"
            android:text="IN"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/w_clients"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView android:id="@+id/w_c1" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/w_chip" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:paddingLeft="6dp" android:paddingRight="6dp" android:textColor="#0F766E" android:textSize="13sp" android:textStyle="bold" android:visibility="gone" />
        <TextView android:id="@+id/w_c2" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/w_chip" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:paddingLeft="6dp" android:paddingRight="6dp" android:textColor="#0F766E" android:textSize="13sp" android:textStyle="bold" android:visibility="gone" />
        <TextView android:id="@+id/w_c3" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/w_chip" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:paddingLeft="6dp" android:paddingRight="6dp" android:textColor="#0F766E" android:textSize="13sp" android:textStyle="bold" android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
